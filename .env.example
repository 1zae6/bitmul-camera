# 이 파일을 복사해 .env 를 만들고 값을 채운다. .env 는 GitHub에 올라가지 않는다.

# Supabase → Project Settings → API Keys(또는 Data API) 화면
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# anon(public) 키 또는 Publishable 키. 공개용 키라 앱 코드에 들어가도 된다. service_role / secret 키는 절대 넣지 않는다.
VITE_SUPABASE_ANON_KEY=

# Supabase → Authentication → Users 에서 만든 팀 공용 계정의 이메일 (비밀번호는 여기에 쓰지 않는다)
VITE_TEAM_EMAIL=
